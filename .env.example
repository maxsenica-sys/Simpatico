# Required for captions (pass 1). https://console.soniox.com
SONIOX_API_KEY=
# Optional overrides
# SONIOX_MODEL=stt-rt-v6
# SONIOX_URL=wss://stt-rt.soniox.com/transcribe-websocket

# Pass 2 idiomatic refinement. Without it, captions stay on Soniox's literal translation.
ANTHROPIC_API_KEY=
# REFINE_MODEL=claude-haiku-5-5

# Only add if a call ever fails to connect over plain STUN (Cloudflare Realtime TURN, managed).
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
